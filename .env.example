# Backend server
PORT=5001
APP_PUBLIC_URL=https://your-public-domain.com
API_PUBLIC_URL=https://your-api-domain.com
FRONTEND_URL=https://your-frontend-domain.com
# Other sites allowed to call the API, comma-separated (e.g. www and Vercel domains)
CORS_ORIGINS=
# Use Lax when frontend/API are same-site. Use None only for cross-site HTTPS deployments.
# Use None when frontend and API are on different sites; requires NODE_ENV=production (Secure cookies).
AUTH_COOKIE_SAME_SITE=None

# Supabase
# Required for auth, workspace, onboarding, leads, calls, outcomes, and meetings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for provider webhooks and background workers because those requests
# do not have a signed-in user session.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Billing (Singapore account, USD annual Prices)
# Create the two recurring annual Prices in Stripe, then set their price_ IDs.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ATELIER_ANNUAL=price_replace_me
STRIPE_PRICE_MAISON_ANNUAL=price_replace_me

# Lead search and enrichment
# Required for lead search + enrichment.
APOLLO_API_KEY=your-provider-api-key

# Public research used for evidence-backed email writing. Keep this token on
# the backend only. Actor IDs can be replaced without changing CircleOn AI code.
APIFY_API_TOKEN=your-apify-api-token
APIFY_WEBSITE_ACTOR_ID=apify~website-content-crawler
APIFY_COMPANY_ACTOR_ID=harvestapi~linkedin-company
APIFY_PERSON_POSTS_ACTOR_ID=apimaestro~linkedin-profile-posts
APIFY_COMPANY_POSTS_ACTOR_ID=apimaestro~linkedin-company-posts-batch-scraper-no-cookies
APIFY_TIMEOUT_MS=300000
APIFY_CACHE_TTL_DAYS=7
APIFY_WEBSITE_MAX_PAGES=20
APIFY_WEBSITE_MAX_DEPTH=2
APIFY_PERSON_POST_LIMIT=10
APIFY_COMPANY_POST_LIMIT=10
APIFY_RESEARCH_CONCURRENCY=2
APIFY_RESEARCH_WORKER_CONCURRENCY=1
APIFY_RECONCILE_DELAY_MS=300000

# Required for phone/email enrichment callbacks.
# If omitted, the backend derives it from APP_PUBLIC_URL.
APOLLO_WEBHOOK_URL=https://your-public-domain.com/api/apollo/webhook

# Public "3 free leads" preview. These credentials are used only to send the
# branded research email to the person who requested the preview.
FREE_LEAD_PREVIEW_SMTP_HOST=smtp.example.com
FREE_LEAD_PREVIEW_SMTP_PORT=587
FREE_LEAD_PREVIEW_SMTP_USER=preview@example.com
FREE_LEAD_PREVIEW_SMTP_PASS=replace-with-smtp-password
FREE_LEAD_PREVIEW_FROM_EMAIL=preview@example.com
FREE_LEAD_PREVIEW_FROM_NAME=CircleOn
FREE_LEAD_PREVIEW_REPLY_TO=
FREE_LEAD_PREVIEW_EMAIL_COOLDOWN_MS=86400000
FREE_LEAD_PREVIEW_IP_MAX=10
# Keep false in production when the dedicated PM2 worker is running.
FREE_LEAD_PREVIEW_WORKER_ENABLED=false
FREE_LEAD_PREVIEW_WORKER_CONCURRENCY=1

# Retell voice agent + calls
# Required to create Retell LLMs/agents and place outbound calls.
RETELL_API_KEY=your-retell-api-key
RETELL_API_BASE=https://api.retellai.com
RETELL_DEFAULT_VOICE_ID=11labs-Adrian

# AI provider. Azure OpenAI is selected automatically when its three required
# variables below are present. Uncomment only when you need to override that
# automatic selection.
# AI_PROVIDER=azure-openai
AI_MAX_RETRIES=3

# Gemini fallback (used only when Azure OpenAI is not configured or AI_PROVIDER=gemini).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Azure OpenAI. The deployment is your Azure deployment name, not merely a model family.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# Email V1
# Required for encrypting user SMTP/IMAP passwords in connected_accounts.
# Use a long random string or a 64-character hex key.
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Required for BullMQ email send/reply polling workers.
REDIS_URL=redis://127.0.0.1:6379
EMAIL_SEND_WORKER_CONCURRENCY=3
LEAD_IMPORT_WORKER_CONCURRENCY=2
LEAD_IMPORT_WORKER_ENABLED=true
APIFY_RESEARCH_WORKER_ENABLED=true
AUTOPILOT_WORKER_ENABLED=true
POLL_INBOX_INTERVAL_MS=180000

# Required when creating Retell agents so Retell can send call events back.
RETELL_WEBHOOK_URL=https://your-public-domain.com/api/retell/webhook

# Optional but recommended once Retell webhook signing is configured.
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# Automatic calling queue
# Keep false until Supabase service role, Retell, telephony, and compliance
# checks have been verified with test leads.
CALLING_QUEUE_ENABLED=false
CALLING_QUEUE_INTERVAL_MS=60000

# PDPC DNC API
# Currently paused. Leave blank until the official DNC account/API approval,
# UAT, IP allowlist, and key setup are complete.
PDPC_DNC_API_URL=
PDPC_DNC_ACCOUNT_ID=

# --- Voice campaigns -------------------------------------------------------
# The dialer. Runs campaign-scoped outbound calls; replaces CALLING_QUEUE_*.
VOICE_QUEUE_ENABLED=false
VOICE_QUEUE_INTERVAL_MS=30000

# Retell. Singapore numbers are always imported from the customer's own Twilio
# Elastic SIP Trunk; Retell does not sell +65 numbers.
RETELL_API_KEY=
RETELL_API_BASE=https://api.retellai.com
RETELL_WEBHOOK_URL=
RETELL_WEBHOOK_SECRET=
RETELL_DEFAULT_VOICE_ID=
# Caps call length at the provider so an agent designed for a two minute call
# cannot run long and cost real money.
RETELL_MAX_CALL_DURATION_MS=180000

# Prepaid call credits. Both of these are commercial decisions, not defaults to
# be relied on: VOICE_CREDIT_MARGIN is the multiplier on the raw provider cost,
# and VOICE_CHARGE_UNANSWERED decides whether a call nobody answered is billed.
VOICE_CREDIT_MARGIN=1
VOICE_CHARGE_UNANSWERED=false
VOICE_MIN_BALANCE_CENTS=60

# Fallback PDPC Do Not Call endpoint. Credentials themselves are per workspace,
# because a PDPC account is bound to one organisation's UEN.
PDPC_DNC_API_URL=

# --- Calendar booking ------------------------------------------------------
# The agent offers real open times and books the meeting during the call.
# calendar.events is a SENSITIVE scope: public launch needs Google verification
# (verified domain, published privacy policy, demo video, 3-5 business days).
# Testing mode allows 100 users with no review, so this blocks launch, not dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-api-host/api/calendar/google/callback
APP_BASE_URL=http://localhost:3000

# Where Retell calls back to reach the booking tools mid-call, and the shared
# secret those endpoints require. Without both, the agent falls back to
# offering a booking link instead of real times.
RETELL_FUNCTION_BASE_URL=
RETELL_FUNCTION_SECRET=

# Monthly pricing launch configuration (checkout stays closed until approved).
STRIPE_MONTHLY_PORTAL_CONFIGURATION_ID=
CIRCLEON_ADMIN_USER_IDS=
BILLING_SMTP_URL=
BILLING_FROM_EMAIL=
API_PUBLIC_URL=
# JSON object mapping Twilio account SID to its signing token.
BILLING_TWILIO_ACCOUNT_TOKENS=
# Webhook-badged Retell API key, if different from RETELL_API_KEY.
RETELL_WEBHOOK_API_KEY=
